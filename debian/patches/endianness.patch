Author: Alastair McKinstry <mckinstry@debian.org>
Description: Force .mo files to all be little-endian so that the libnewt package can be M-A: same
Last-Updated: 2013-05-14
Forwarded: no

Index: newt-0.52.24/po/Makefile
===================================================================
--- newt-0.52.24.orig/po/Makefile
+++ newt-0.52.24/po/Makefile
@@ -42,7 +42,7 @@ update-po: $(NLSPACKAGE).pot Makefile re
 report:
 	@for cat in $(CATALOGS); do \
 		echo -n "$$cat: "; \
-		msgfmt -v --statistics -o /dev/null $$cat; \
+		msgfmt --endianness little -v --statistics -o /dev/null $$cat; \
 	done
 
 clean:
